# ==============================================================================
# HyperCapsule — Comprehensive Android Git Ignore Rules
# ==============================================================================

# Built application packages & binaries
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java & Kotlin class files
*.class

# Generated build output directories
bin/
gen/
out/
build/
app/build/
.gradle/
.kotlin/

# Local developer configuration & SDK paths
local.properties
gradle.properties.local

# Keystores, signing properties and private secrets
*.jks
*.keystore
*.key
*.pem
*.p12
*.bks
hypercapsule-release.jks
keystore.properties
signing.properties

# Proguard / R8 generated mappings and seeds
proguard/
mapping.txt
seeds.txt
usage.txt

# Log & Diagnostic files
*.log
*.tmp
*.bak
caps_build.txt

# Android Studio & IntelliJ project state
*.iml
*.ipr
*.iws
.idea/
.navigation/
captures/

# External native builds (NDK/CMake/Ninja)
.externalNativeBuild/
.cxx/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Compose compiler metrics and reports
*compose_metrics.txt
*compose_reports.txt

# Internal Prompts, Scratch and Working Notes
Prompt.txt
prompt.txt
scratch/
temp/
tmp/

# Legacy audit & review reports (internal scratch)
FORENSIC_AUDIT/
REMEDIATION_REPORT/
VISUAL_REVIEW/
ANIMATION_AUDIT.md
ANIMATION_IMPLEMENTATION_REPORT.md
APP_LIBRARY_TOGGLE_BUG_REPORT.md
BRANDING_MIGRATION_PLAN.md
CODE_CLEANUP_PLAN.md
DESIGN_RESEARCH.md
FEATURE_PRESERVATION_INVENTORY.md
FINAL_PHASE1_REPORT.md
FINAL_UI_POLISH_REPORT.md
PACKAGE_MIGRATION_PLAN.md
PERFORMANCE_AUDIT.md
PROJECT_AUDIT.md
UI_COMPONENT_INVENTORY.md
UI_FEATURE_PRESERVATION_REPORT.md
UI_INTERACTION_MATRIX.md
UI_REDESIGN_PLAN.md
UI_REDESIGN_REPORT.md
UI_REFINEMENT_REPORT.md
UI_SCREEN_COMPLETION_MATRIX.md
UI_SCREEN_INVENTORY.md
VISUAL_REGRESSION_MATRIX.md
VISUAL_REGRESSION_REPORT.md
VISUAL_REVIEW_REPORT.md
